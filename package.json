{
  "name": "landing-ml",
  "version": "0.1.0",
  "private": true,
  "description": "Landing de relevamiento autoguiado que deriva consultas a WhatsApp — Mariano Lemos Barbaro",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/harden-build.mjs",
    "verify": "node scripts/verify-site.mjs --dir out --manifest .integrity/manifest.json",
    "start": "npx serve out",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/saira": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
